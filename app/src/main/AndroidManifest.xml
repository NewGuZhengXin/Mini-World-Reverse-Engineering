<?xml version="1.0" encoding="utf-8"?>
<!--
  Restored from the binary AndroidManifest.xml of FakerVsBin.apk (apktool decode).

  Differences with the original file:
    * the "package" attribute moved into app/build.gradle (namespace / applicationId),
      as required by Android Gradle Plugin 8;
    * android:exported added to the two activities so the APK can also be installed
      on Android 12+ devices.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:debuggable="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.minitech.miniworld.SplashScreenActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.minitech.miniworld.MiniWorldActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="com.minitech.miniworld.MiniWorldActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data android:name="isnettable" android:value="false" />
        <meta-data android:name="isdebug" android:value="false" />
        <meta-data android:name="pfsdkname" android:value="unknown" />
        <meta-data android:name="appname" android:value="miniworld" />
        <meta-data android:name="istest" android:value="false" />
        <meta-data android:name="url_libso" android:value="http://www.***.com/DataUpdateAndroid/libAppPlayJNI.so" />
        <meta-data android:name="url_version" android:value="http://www.***.com/DataUpdateAndroid/version.xml" />
        <meta-data android:name="url_libso_test" android:value="http://www.***.com/test/DataUpdateAndroid/libAppPlayJNI.so" />
        <meta-data android:name="url_version_test" android:value="http://www.***.com/test/DataUpdateAndroid/version.xml" />
    </application>
</manifest>
