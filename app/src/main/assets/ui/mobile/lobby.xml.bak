<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/lobby.lua" />
	<Frame name="GongNengFrame" parent="UIClient" frameStrata="BACKGROUND" hidden="true" framelevel="2">
		<Size>
			<AbsDimension x="170" y="100"/>
		</Size>	
		<Anchors>
			<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
				<Offset>
					<AbsDimension x="-20" y="18"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Button name="$parentGongNengBtn">
				<Size>
					<AbsDimension x="60" y="60"/>
				</Size>
				<Anchors>
					<Anchor point="topright" relativeTo="$parent" relativePoint="topright">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui.png" x="653" y="3" w="60" h="60"/>
				<PushedTexture name="$parentPushed" file="ui/mobile/ui.png" x="714" y="3" w="60" h="60"/>
				<Scripts>
					<OnClick>GongNengFrameGongNengBtn_OnClick();</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentVip">
				<Size>
					<AbsDimension x="108" y="82"/>
				</Size>
				<Anchors>
					<Anchor point="right" relativeTo="$parentGongNengBtn" relativePoint="left">
						<Offset>
							<AbsDimension x="-10" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<Texture name="$parentUVAnimationTex" file="ui/mobile/effect/ui_button_vip.png" hidden="true">
							<Size>
								<AbsDimension x="180" y="180"/>
							</Size>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="10" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>	
							<UVAnimation texrows="4" texcols="4" />
						</Texture>
					</Layer>
				</Layers>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui.png" x="927" y="3" w="96" h="76"/>
				<PushedTexture name="$parentPushed" file="ui/mobile/ui.png" x="927" y="3" w="96" h="76"/>
				<Scripts>
					<OnClick>GongNengFrameVipBtn_OnClick();</OnClick>
				</Scripts>
			</Button>
			<Frame name="$parentList" hidden="true">
				<Size>
					<AbsDimension x="70" y="340"/>
				</Size>	
				<Anchors>
					<Anchor point="top" relativePoint="bottom" relativeTo="$parentGongNengBtn">
