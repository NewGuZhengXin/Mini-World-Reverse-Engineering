	<Frame name="LobbyFrame" parent="UIClient" frameStrata="BACKGROUND" hidden="true" framelevel="1">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/login_bg.png">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentRoleBkg" inherits="GaryBkgTemplate" color="d6ffffff">
					<Size>
						<AbsDimension x="485" y="687"/>
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="15" y="20"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentAdorn" file="ui/mobile/ui2.png" x="3" y="136" w="224" h="76">
					<Size>
						<AbsDimension x="252" y="86"/>
					</Size>
					<Anchors>
						<Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parentRoleBkg">
							<Offset>
								<AbsDimension x="190" y="-10"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentRoleChenDi" inherits="BlackBkgTemplate" >
					<Size>
						<AbsDimension x="357" y="501"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentRoleBkg">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentRoleName" fonttype="BlackFont24" lineInterval="2" text="采蘑菇的小熊酱" fontStyle="border" >
					<Color r="255" g="255" b="255"/>
					<Size>
						<AbsDimension x="200" y="25"/>
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentRoleBkg">
							<Offset>
								<AbsDimension x="155" y="16"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentUin" fonttype="BlackFont28" lineInterval="2" text="Uni帐号" fontStyle="border" >
					<Color r="255" g="229" b="64"/>
					<Size>
						<AbsDimension x="200" y="29"/>
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="bottomleft" relativeTo="$parentRoleName">
							<Offset>
								<AbsDimension x="0" y="10"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentBlueJewel" file="ui/mobile/ui.png" x="434" y="213" w="49" h="53" >
					<Size>
						<AbsDimension x="55" y="60"/>
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="563" y="20"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentJewelFont" fonttype="BlackFont34" lineInterval="2" text="123456789" fontStyle="border" >
					<Color r="255" g="230" b="67"/>
					<Size>
						<AbsDimension x="170" y="34"/>
					</Size>
					<Anchors>
						<Anchor point="left" relativePoint="right" relativeTo="$parentBlueJewel">
							<Offset>
								<AbsDimension x="15" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK">
				<ModelView name="$parentRoleView">
					<Size>
						<AbsDimension x="280" y="450"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativeTo="$parentRoleChenDi" relativePoint="center">
							<Offset>
								<AbsDimension x="0" y="-40" />
							</Offset>
						</Anchor>
					</Anchors>
				</ModelView>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCollectBtn">
				<Size>
					<AbsDimension x="106" y="110"/>
				</Size>
				<Anchors>
					<Anchor point="bottomleft" relativeTo="$parentRoleBkg" relativePoint="bottomleft">
						<Offset>
							<AbsDimension x="1" y="-3"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui.png" x="542" y="878" w="94" h="98" />		
				<PushedTexture name="$parentPushedBG" file="ui/mobile/ui.png" x="639" y="878" w="94" h="98" />
				<Scripts>
					<OnClick>LobbyFrameCollectBtn_OnClick();</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentHeadBtn">
				<Size>
					<AbsDimension x="90" y="92"/>
				</Size>
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentRoleBkg" relativePoint="topleft">
						<Offset>
							<AbsDimension x="26" y="29"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<Texture name="$parentIcon">
							<Size>
								<AbsDimension x="65" y="65" />
							</Size>
							<Anchors>
								<Anchor point="bottom" relativeTo="$parent" relativePoint="bottom">
									<Offset>
										<AbsDimension x="0" y="-14" />
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<Texture name="$parentVipBkg" file="ui/mobile/ui.png" x="811" y="649" w="56" h="63" >
							<Size>
								<AbsDimension x="63" y="71"/>
							</Size>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
									<Offset>
										<AbsDimension x="54" y="-25"/>
									</Offset>
								</Anchor>
							</Anchors>
