				<Frames>>
					<Button name="$parentMapBtn">
						<Size>
							<AbsDimension x="79" y="79"/>
						</Size>
						<Anchors>
							<Anchor point="topright" relativeTo="$parent" relativePoint="topright">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="overlay">
								<Texture name="$parentName" file="ui/mobile/ui1.png" x="919" y="901" w="50" h="29">
									<Size>
										<AbsDimension x="56" y="33"/>
									</Size>
									<Anchors>
