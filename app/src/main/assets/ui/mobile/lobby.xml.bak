						<NormalTexture name="$parentNormal" file="ui/mobile/ui2.png" x="308" y="208" w="70" h="70"/>
						<PushedTexture name="$parentPushed" file="ui/mobile/ui2.png" x="380" y="208" w="70" h="70"/>
						<Scripts>
							<OnClick>GongNengFrameListMapBtn_OnClick();</OnClick>
						</Scripts>
					</Button>
					<Button name="$parentFriendBtn">
						<Size>
							<AbsDimension x="79" y="79"/>
						</Size>
						<Anchors>
							<Anchor point="top" relativeTo="$parentMapBtn" relativePoint="bottom">
								<Offset>
									<AbsDimension x="0" y="5" />
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="overlay">
								<Texture name="$parentName" file="ui/mobile/ui1.png" x="972" y="901" w="50" h="28">
									<Size>
										<AbsDimension x="56" y="32"/>
									</Size>
									<Anchors>
