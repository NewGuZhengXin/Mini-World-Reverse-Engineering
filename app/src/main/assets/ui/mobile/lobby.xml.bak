							</Layer>
						</Layers>
						<NormalTexture name="$parentNormal" file="ui/mobile/ui2.png" x="308" y="208" w="70" h="70"/>
						<PushedTexture name="$parentPushed" file="ui/mobile/ui2.png" x="380" y="208" w="70" h="70"/>
