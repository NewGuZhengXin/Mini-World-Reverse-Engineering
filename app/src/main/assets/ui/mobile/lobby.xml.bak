		<Scripts>
			<OnShow>GongNengFrame_OnShow();</OnShow>
			<OnHide>GongNengFrame_OnHide();</OnHide>
		</Scripts>
	</Frame>
	#存档条模版
	<Frame name="ArchiveTemplate" virtual="true">
		<Size>
			<AbsDimension x="588" y="130"/>
		</Size>	
		<Frames>
			<Button name="$parentDelete">
				<Size>
					<AbsDimension x="74" y="75"/>
				</Size>
				<Anchors>
					<Anchor point="left" relativePoint="left" relativeTo="$parent">
						<Offset>
							<AbsDimension x="16" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui1.png" x="823" y="163" w="66" h="67" />		
				<PushedTexture name="$parentPushedBG" file="ui/mobile/ui1.png" x="892" y="163" w="66" h="67" />
				<Scripts>
					<OnClick>ArchiveDelete_OnClick();</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentShare">
				<Size>
					<AbsDimension x="74" y="75"/>
				</Size>
				<Anchors>
					<Anchor point="left" relativePoint="right" relativeTo="$parentDelete">
						<Offset>
							<AbsDimension x="11" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui1.png" x="823" y="232" w="66" h="67" />		
				<PushedTexture name="$parentPushedBG" file="ui/mobile/ui1.png" x="892" y="232" w="66" h="67" />
				<Scripts>
					<OnClick>ArchiveShare_OnClick();</OnClick>
				</Scripts>
			</Button>	
			<SlidingFrame name="$parentSlidingFrame" slidingX="true" movestartX="170" slideplane="$parentPlane">
				<Size>
					<AbsDimension x="572" y="114"/>
				</Size>
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<Offset>
							<AbsDimension x="16" y="16" />
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Frame name="$parentPlane" hidden="true">
						<Size>
							<AbsDimension x="572" y="114"/>
						</Size>
					</Frame>
					<Frame name="$parentbg112">
						<Anchors>
							<Anchor point="bottomleft" relativeTo="$parentPlane" relativePoint="bottomleft">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
							<Anchor point="bottomright" relativeTo="$parent" relativePoint="bottomright">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="BACKGROUND">
								<Texture name="$parentBkg" inherits="GaryBkgTemplate">
								</Texture>
							</Layer>
						</Layers>
					</Frame>
					<Button name="$parentContent" click_threshold="5">
						<Size>
							<AbsDimension x="572" y="114" />
						</Size>
						<Anchors>
							<Anchor point="left" relativePoint="left" relativeTo="$parentPlane">
								<Offset>
									<AbsDimension x="0" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="BACKGROUND">
								<Texture name="$parentModelIcon" file="ui/mobile/ui1.png" x="822" y="84" w="76" h="76">
									<Size>
										<AbsDimension x="86" y="86" />
									</Size>
									<Anchors>
										<Anchor point="topleft" relativeTo="$parent" relativePoint="topleft">
											<Offset>
												<AbsDimension x="19" y="12" />
											</Offset>
										</Anchor>
									</Anchors>
								</Texture>
								<Texture name="$parentHeadIcon" file="ui/roleicons/1.png">
									<Size>
										<AbsDimension x="65" y="65" />
									</Size>
									<Anchors>
										<Anchor point="topleft" relativeTo="$parent" relativePoint="topleft">
											<Offset>
												<AbsDimension x="317" y="20" />
											</Offset>
										</Anchor>
									</Anchors>
								</Texture>
								<FontString name="$parentTime" fonttype="BlackFont18" lineInterval="2" text="世界探索：2天前">
									<Color r="255" g="230" b="67"/>
									<Size>
										<AbsDimension x="190" y="18"/>
									</Size>
									<Anchors>
										<Anchor point="left" relativePoint="right" relativeTo="$parentHeadIcon">
											<Offset>
												<AbsDimension x="6" y="0"/>
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Frames>
							<RichText name="$parentName" lineInterval="4" multiLine="false" fonttype="BlackFont28" fontStyle="border" autoextend="false" input_transparent="true">
								<Size>
									<AbsDimension x="200" y="90" />
								</Size>
								<Anchors>
									<Anchor point="left" relativeTo="$parentModelIcon" relativePoint="right">
										<Offset>
											<AbsDimension x="10" y="0" />
										</Offset>
									</Anchor>
								</Anchors>
							</RichText>
						</Frames>
						<Scripts>
							<OnClick>ArchiveContent_OnClick();</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</SlidingFrame>
			<Button name="$parentBkg" hidden="true">
				<Size>
					<AbsDimension x="572" y="114"/>
				</Size>
				<Anchors>
					<Anchor point="left" relativePoint="left" relativeTo="$parent">
						<Offset>
							<AbsDimension x="16" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" inherits="GaryBkgTemplate" />
			</Button>
			<Button name="$parentShareIcon" hidden="true">
				<Size>
					<AbsDimension x="48" y="50"/>
				</Size>
				<Anchors>
					<Anchor point="center" relativePoint="topleft" relativeTo="$parentSlidingFrameContent">
						<Offset>
							<AbsDimension x="10" y="10"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/ui.png" x="915" y="589" w="43" h="44" />		
			</Button>
		</Frames>	
	</Frame>
