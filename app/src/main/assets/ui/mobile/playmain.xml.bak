<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/playmain.lua"/>
	<Frame name="PlayMainFrame" parent="UIClient" frameStrata="BACKGROUND" input_transparent="true" hidden="true" framelevel="1">
